{
  "id": "pol-inbound-country",
  "name": "Inbound by customer country",
  "version": "1.0.0",
  "statements": [
    {
      "sid": "inbound-nordic-only",
      "effect": "allow",
      "actions": [
        "file:getFile",
        "file:listFiles"
      ],
      "resources": [
        "crn:ba62a53f-afa9-427d-9d91-c7987bc5662e:*:file::file:files/inbound/**"
      ],
      "conditions": {
        "StringEquals": {
          "inbound:customer:country_code": ["NO", "SE", "DK"]
        }
      }
    }
  ]
}
